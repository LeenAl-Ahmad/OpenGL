#version 330 core

// Input from the application (these come from the vertex buffer)
in vec3 inPosition;    // Vertex position
in vec3 inNormal;      // Vertex normal
in vec2 inTexCoord;    // Texture coordinates

// Outputs to the fragment shader
out vec3 fragPos;      // World position of the fragment
out vec3 fragNormal;   // Normal vector in world space
out vec2 fragTexCoord; // Texture coordinates

// Uniforms
uniform mat4 model;    // Model matrix (transforms object coordinates to world space)
uniform mat4 view;     // View matrix (camera space)
uniform mat4 projection; // Projection matrix (for perspective)

void main() {
    // Calculate the world position of the vertex
    fragPos = vec3(model * vec4(inPosition, 1.0));

    // Transform the normal from object space to world space
    fragNormal = mat3(transpose(inverse(model))) * inNormal;

    // Pass the texture coordinates unchanged
    fragTexCoord = inTexCoord;

    // Apply the model-view-projection transformation to the vertex position
    gl_Position = projection * view * vec4(fragPos, 1.0);
}
