#version 330 core

in vec3 FragPos;      // Fragment position in world space
in vec3 Normal;       // Normal vector at the fragment
in vec3 Color;        // Color passed from vertex shader or modified by UI
out vec4 FragColor;   // Final color output

uniform bool moveLight;     // Flag to indicate if the light should move
uniform vec3 lightPos;      // Light position from UI
uniform vec3 viewPos;       // Camera position
uniform vec3 lightColor;    // Light color (can be adjusted via UI)
uniform float specularStrength; // Specular strength from UI
uniform float redBar;       // Red component of specular color
uniform float greenBar;     // Green component of specular color
uniform float blueBar;      // Blue component of specular color
uniform bool colorByPosition; // Flag to indicate if the color should be based on position

void main()
{
    // Normalize vectors
    vec3 norm = normalize(Normal);
    vec3 lightDir = normalize(lightPos - FragPos);
    vec3 viewDir = normalize(viewPos - FragPos);

    // Ambient lighting (constant)
    vec3 ambient = 0.1 * lightColor;

    // Diffuse shading (Lambertian)
    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = diff * lightColor;

    // Specular shading (Phong model)
    vec3 reflectDir = reflect(-lightDir, norm);  
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), 32);
    vec3 specular = specularStrength * spec * lightColor;

    // If "Color By Position" is selected, modify color based on world position
    if (colorByPosition)
    {
        // Tint based on world position (X for red, Y for green, Z for blue)
        vec3 positionTint = vec3(abs(FragPos.x), abs(FragPos.y), abs(FragPos.z));
        result = (ambient + diffuse + specular) * positionTint; // Apply tint
    }
    else
    {
        // Combine results with the specular color adjustments
        vec3 result = (ambient + diffuse + specular) * Color;
    }

    // Output the final color, adjusting for specular color components
    FragColor = vec4(result * vec3(redBar / 100.0, greenBar / 100.0, blueBar / 100.0), 1.0);
}
