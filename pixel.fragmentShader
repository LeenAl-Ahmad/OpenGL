#version 330 core

// Input from the vertex shader
in vec3 fragPos;      // World position of the fragment
in vec3 fragNormal;   // Normal vector in world space
in vec2 fragTexCoord; // Texture coordinates
in vec3 fragTrackBarColor; // Color passed from vertex shader

// Output
out vec4 FragColor;   // Final color of the fragment (pixel)

// Uniforms
uniform sampler2D diffuseTexture; // Diffuse texture
uniform vec3 lightPos;  // Light position
uniform vec3 viewPos;   // Camera (view) position
uniform vec3 lightColor; // Light color

// Material properties
uniform float shininess; // Shininess for specular lighting
uniform vec3 specularColor; // Specular color controlled by uniforms

void main() {
    // Ambient lighting: constant term (could be modified further)
    vec3 ambient = 0.1 * lightColor;

    // Diffuse lighting: Lambert's cosine law
    vec3 norm = normalize(fragNormal);
    vec3 lightDir = normalize(lightPos - fragPos);
    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = diff * lightColor;

    // Specular lighting: Phong model
    vec3 viewDir = normalize(viewPos - fragPos);
    vec3 reflectDir = reflect(-lightDir, norm);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
    vec3 specular = spec * specularColor * lightColor;

    // Texture color
    vec4 texColor = texture(diffuseTexture, fragTexCoord);

    // Color by trackBar value: You can modulate the final color based on the trackBar values
    vec3 finalColor = ambient + diffuse + specular;
    
    // Adjust the color based on the trackBar values
    finalColor *= fragTrackBarColor; // Modulate color with trackBar RGB values

    // Combine with the texture color
    FragColor = vec4(finalColor, 1.0) * texColor;
}
