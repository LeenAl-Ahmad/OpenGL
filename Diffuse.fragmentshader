#version 330 core

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retViewDirection;
in mat3 retTBN;

out vec4 FragColor;

struct Material {
    float specularStrength;            // Specular strength
    sampler2D diffuseTexture;          // Diffuse texture
    sampler2D specularTexture;         // Specular texture
    sampler2D normalTexture;           // Normal map texture
};

struct Light {
    vec3 position;                     // Light position
    vec3 color;                        // Light color
    vec3 ambientColor;                 // Ambient color
    vec3 diffuseColor;                 // Diffuse color
    vec3 specularColor;                // Specular color
    float specularStrength;            // Light's specular strength
};

uniform Material material;            // Material properties
#define NUM_LIGHTS 1
uniform Light light[NUM_LIGHTS];      // Light sources
uniform vec3 AmbientLight;            // Ambient light color
uniform bool EnableNormalMaps = false;        // Toggle normal mapsunifrom 
vec3 specularColor;
uniform float uSpecularStrength;

void main() {
    // Sample diffuse color from texture
    vec4 diffColor = texture(material.diffuseTexture, retTexCoord);
    if (diffColor.a == 0) {
        discard;  // If the texture is fully transparent, discard the fragment
    }

    vec4 finalColor = vec4(0);

    // Loop through lights (currently only one light)
    for (int i = 0; i < NUM_LIGHTS; i++) 
    {
        // Calculate the light direction
        vec3 lightDir = normalize(light[i].position - retFragPos);

        // Use normal map if enabled, otherwise use the original normal
        vec3 normal = retNormal;
        if (EnableNormalMaps == true) 
        {
            normal = texture(material.normalTexture, retTexCoord).rgb;
            normal = normal * 2.0 - 1.0;
            normal = normalize(retTBN * normal); // Apply TBN transformation
        }

        // Lambertian shading: diffuse lighting component
        float lambertianStrength = dot(lightDir, normal);

        // Reflection vector for specular lighting calculation
        vec3 refl = reflect(-lightDir, normal);
        float specularStrength = pow(max(dot(retViewDirection, refl), 0.0), material.specularStrength);

        // Calculate the different lighting components
        vec3 ambient = diffColor.rgb * light[i].ambientColor ;
        vec3 diffuse = lambertianStrength * light[i].diffuseColor * diffColor.rgb;
        vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light[i].specularColor * uSpecularStrength;

        // Sum the ambient, diffuse, and specular components
        finalColor += vec4(ambient + diffuse + specular, 1.0f);
    }

    // Output the final fragment color
    FragColor = finalColor;
}
