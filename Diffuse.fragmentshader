#version 330

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retViewDirection;

out vec4 FragColor;

uniform float SpecularStrength;
uniform vec3 SpecularColor;
uniform vec3 LightPosition; // Duplicate declaration removed
uniform vec3 LightDirection;
uniform vec3 LightColor;
uniform vec3 AmbientLight;
uniform vec3 DiffuseColor;
uniform sampler2D sampler1;
uniform sampler2D sampler2;

void main()
{
    vec3 lightDir = normalize(LightPosition - retFragPos);
    vec3 lambertian = max(dot(lightDir, retNormal), 0.0) * LightColor; // Use max to ensure no negative lighting
    // Specular lighting calculation added
    vec3 refl = reflect(-lightDir, retNormal);
    float spec = pow(max(dot(retViewDirection, refl), 0.0), 32.0);
    vec3 specular = SpecularStrength * spec * SpecularColor;

    // Final color calculation
    vec3 outColor = clamp(lambertian + specular + AmbientLight, 0.0, 1.0) * DiffuseColor;

    FragColor = vec4(outColor, 1.0) * texture(sampler1, retTexCoord);
}
