#version 330 core

in vec3 retFragPos;       // Input: Fragment position in object space
in vec3 retNormal;        // Input: Normal vector in object space
in vec2 retTexCoord;      // Input: Texture coordinates

out vec4 FragColor;       // Output: Final fragment color

struct Material {
    float specularStrength;            // Specular strength
    sampler2D diffuseTexture;          // Diffuse texture
    sampler2D specularTexture;         // Specular texture
    sampler2D normalTexture;           // Normal map texture
};

struct Light {
    vec3 position;                     // Light position
    vec3 color;                        // Light color
    vec3 ambientColor;                 // Ambient color
    vec3 diffuseColor;                 // Diffuse color
    vec3 specularColor;                // Specular color
    float specularStrength;  
    
};

uniform Material material;            // Material properties
#define NUM_LIGHTS 1
uniform Light light[NUM_LIGHTS];      // Array of light sources

uniform mat4 WVP;                     // Combined World-View-Projection matrix
uniform mat4 World;                   // World (model) matrix
uniform vec3 CameraPosition;          // Camera position in world space
uniform vec3 AmbientLight;            // Global ambient light
uniform bool EnableNormalMaps = false; // Toggle for normal mapping
uniform float uSpecularStrength;      // Specular strength control

void main() {
    // Transform fragment position and normal to world space
    vec4 worldPosition = World * vec4(retFragPos, 1.0);
    vec3 worldNormal = normalize(mat3(transpose(inverse(World))) * retNormal);

    // Sample diffuse color from texture
    vec4 diffColor = texture(material.diffuseTexture, retTexCoord);
    if (diffColor.a == 0.0) {
        discard; // Skip fully transparent fragments
    }

    vec3 finalColor = vec3(0.0);

    // Loop through each light source (currently only one light is defined)
    for (int i = 0; i < NUM_LIGHTS; i++) {
        // Calculate light direction and normalize
        vec3 lightDir = normalize(light[i].position - worldPosition.xyz);

        // Use normal map if enabled, otherwise use transformed normal
        vec3 normal = worldNormal;
        if (EnableNormalMaps) {
            normal = texture(material.normalTexture, retTexCoord).rgb;
            normal = normal * 2.0 - 1.0; // Convert from [0, 1] to [-1, 1]
            normal = normalize(normal); // Normalize the result
        }

        // Diffuse lighting (Lambertian reflection)
        float lambertian = max(dot(normal, lightDir), 0.0);
        vec3 diffuse = lambertian * light[i].diffuseColor * diffColor.rgb * vec3(0.8); // Scale down intensity

        // Ambient lighting
        vec3 ambient = diffColor.rgb * light[i].ambientColor * AmbientLight * vec3(0.5); // Slightly reduce intensity

        // Specular lighting (Blinn-Phong model)
        vec3 viewDir = normalize(CameraPosition - worldPosition.xyz);
        vec3 halfDir = normalize(lightDir + viewDir);
        float spec = pow(max(dot(normal, halfDir), 0.0), uSpecularStrength);
        vec3 specular = spec * light[i].specularColor * diffColor.rgb * vec3(0.6); // Scale down specular intensity

        // Accumulate the color contributions
        finalColor += ambient + diffuse + specular;
    }

    // Ensure final color is clamped to valid range
    finalColor = clamp(finalColor, 0.0, 1.0);

    // Output the calculated color
    FragColor = vec4(finalColor, diffColor.a);
}
