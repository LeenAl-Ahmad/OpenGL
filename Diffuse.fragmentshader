#version 330

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retViewDirection;
in mat4 retWorld;

out vec4 FragColor;

struct Material {
    float specularStrength;
    sampler2D diffuseTexture;
    sampler2D specularTexture;
    sampler2D normalTexture;
};

struct Light {
    vec3 position;
    vec3 color;
    vec3 ambientColor;
    vec3 diffuseColor;
    vec3 specularColor;
};

uniform Material material;
#define NUM_LIGHTS 1
uniform Light light[NUM_LIGHTS];
uniform float SpecularStrength;
uniform vec3 SpecularColor;
uniform vec3 LightColor;
uniform vec3 AmbientLight;
uniform vec3 DiffuseColor;
uniform bool EnableNormalMaps; // Default values are not allowed in GLSL uniforms.

void main() {
    vec4 diffColor = texture(material.diffuseTexture, retTexCoord);
    if (diffColor.a == 0.0) {
        discard;
    }
    vec4 finalColor = vec4(0.0);
    for (int i = 0; i < NUM_LIGHTS; i++) {
        // Calculate light direction
        vec3 lightDir = normalize(light[i].position - retFragPos);

        vec3 normal = retNormal;
        if (EnableNormalMaps) {
            normal = texture(material.normalTexture, retTexCoord).rgb;
            normal = normal * 2.0 - 1.0;
            normal = normalize(mat3(retWorld) * normal);
        }
        float lambertianStrength = max(dot(lightDir, normal), 0.0); // Fixed typo: "lamdertianStrength".

        // Specular lighting calculation
        vec3 refl = reflect(-lightDir, normal);
        float specularStrength = pow(max(dot(retViewDirection, refl), 0.0), material.specularStrength);

        // Calculate ambient, diffuse, and specular components
        vec3 ambient = diffColor.rgb * light[i].ambientColor / float(NUM_LIGHTS);
        vec3 lambertian = lambertianStrength * diffColor.rgb * light[i].diffuseColor;
        vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light[i].specularColor;

        // Accumulate final color
        finalColor += vec4(ambient + lambertian + specular, diffColor.a);
    }

    FragColor = finalColor;
}
