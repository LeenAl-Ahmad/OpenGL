#version 330

in vec3 retFragPos;
in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retViewDirection;

out vec4 FragColor;

struct Material {
    float shininess;             // Used for the specular exponent
    float specularStrength;      // Specular intensity scalar
    sampler2D diffuseTexture;
    sampler2D specularTexture;
};

struct Light {
    vec3 position;
    vec3 color;
    vec3 ambientColor;
    vec3 diffuseColor;
    vec3 specularColor;
};

uniform Material material;
#define NUM_LIGHTS 1
uniform Light light[NUM_LIGHTS];

void main() 
{
    vec4 diffColor = texture(material.diffuseTexture, retTexCoord);
    if (diffColor.a == 0) {
        discard;  // If the texture is fully transparent, discard the fragment
    }
    vec4 finalColor = vec4(0.0);

    for (int i = 0; i < NUM_LIGHTS; i++) {
        // Calculate light direction
        vec3 lightDir = normalize(light[i].position - retFragPos);

        // Calculate Lambertian (diffuse) strength
        float lambertianStrength = max(dot(lightDir, retNormal), 0.0);

        // Specular lighting calculation
        vec3 refl = reflect(-lightDir, retNormal);
        float specularStrength = pow(max(dot(retViewDirection, refl), 0.0), material.shininess);

        // Calculate ambient, diffuse, and specular components
        vec3 ambient = diffColor.rgb * light[i].ambientColor/NUM_LIGHTS;
        vec3 lambertian = lambertianStrength * light[i].diffuseColor * diffColor.rgb;
        vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light[i].specularColor;
        // Accumulate final color
        finalColor += vec4(ambient + lambertian + specular, 1.0f);
    }

    FragColor = vec4(finalColor.rgb, diffColor.a);
}
